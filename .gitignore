# ========================================================
# AI GitHub Project Analyzer - Root .gitignore
# ========================================================

# 1. Environment variables & Secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# Allow example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
package-lock.json.backup

# 3. Production and Distribution Artifacts
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
build/

# 4. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Scratch & Local Verification Files
backend/scratch/
scratch/
.temp/
temp/

# 6. Operating System & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
